#!/bin/bash

set -o nounset -o pipefail -o errexit

SCRIPT_DIR=$(readlink -f "$0" | xargs dirname)
TOOLS=${TOOLS-$SCRIPT_DIR/../tools}

COMMIT_MSG_FILE=$1
COMMIT_SOURCE_REV=${3-HEAD}

TMP=$(mktemp -d)
trap 'rm -rf $TMP' EXIT

APPEND=$TMP/append

mapfile -t ADDED < <(git diff-tree -r --name-only --no-commit-id --diff-filter="A" "$COMMIT_SOURCE_REV")
for f in "${ADDED[@]}"; do
    if [[ ${f/%.tex/} = "$f" ]]; then
        continue
    fi
    AFTER=$("$TOOLS/words" -fstrict <"$f")
    echo "$f: $AFTER words" >>"$APPEND"
done

mapfile -t MODIFIED < <(git diff-tree -r --name-only --no-commit-id --diff-filter="M" "$COMMIT_SOURCE_REV")
for f in "${MODIFIED[@]}"; do
    if [[ ${f/%.tex/} = "$f" ]] || [[ ! -e $f ]]; then
        continue
    fi
    BEFORE=$(git show "$COMMIT_SOURCE_REV:$f" | "$TOOLS/words" -fstrict)
    AFTER=$("$TOOLS/words" -fstrict <"$f")
    N=$((AFTER-BEFORE))
    if [[ $N -gt 0 ]]; then
        echo "$f: $AFTER (+$N) words" >>"$APPEND"
    elif [[ $N -lt 0 ]]; then
        echo "$f: $AFTER ($N) words" >>"$APPEND"
    fi
done

if [[ ! -e $APPEND ]]; then
    exit 0
fi

OLD="$TMP/old"
grep -vxE '[^:]+:[ 0-9+()]+words' "$COMMIT_MSG_FILE" >"$OLD"

NEW="$TMP/new"
python - "$OLD" "$APPEND" <<'EOF' >"$NEW"
import sys
with open(sys.argv[1]) as f:
    done = False
    for l in f:
        l = l.rstrip()
        if not done and l.startswith("#"):
            with open(sys.argv[2]) as g:
                for k in g:
                    print(k.rstrip())
            done = True
        print(l)
EOF

cp "$NEW" "$COMMIT_MSG_FILE"
