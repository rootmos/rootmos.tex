#!/bin/bash

set -o nounset -o pipefail -o errexit

TEXHELP=${TEXHELP-texhelp}

OUTPUT=/dev/stdout
FORMAT=pretty
while getopts "o:f:-" OPT; do
    case $OPT in
        o) OUTPUT=$OPTARG ;;
        f) FORMAT=$OPTARG ;;
        -) break ;;
        ?) exit 2 ;;
    esac
done
shift $((OPTIND-1))
INPUT=${1--}

TMP=$(mktemp -d)
trap 'rm -rf $TMP' EXIT

cat <<'EOF' >"$TMP/opt"
-noinc
-nobib

%macro \pc [ignore]
%macro \tc [ignore]
%macro \tcs [ignore]
%macro \pcin [ignore,ignore]
%macro \tcin [ignore,ignore]
%macro \tcsin [ignore,ignore]

%macro \tq [ignore,other]
%macro \bq [ignore,other]
%macro \bqin [ignore,ignore,other]
%macro \tqin [ignore,ignore,other]

%macro \skeleton [ignore,ignore,option:ignore,option:ignore]

%macro \q [text]
%macro \qo [other]
%macro \qi [ignore]

%macro \todo [ignore]
%macro \todoi [ignore]
EOF

# TODO abbreviations

set +e
"$TEXHELP" -e texcount \
    -opt="$TMP/opt" \
    -template='return {text={1},other={3}}' \
    "$INPUT" 1>"$TMP/words.lua" 2>"$TMP/stderr"
EC=$?
set -e

if [[ $EC -ne 0 ]]; then
    cat "$TMP/stderr" 1>&2
    exit $EC
else
    grep -v "^SUMWEIGHTS" "$TMP/stderr" \
        | grep -v "^Possible precedence problem between" \
        | cat 1>&2 || true
fi

_lua() {
    lua - "$TMP/words.lua" <<EOF
local w = dofile(arg[1])
print($1)
EOF
}

if [[ $FORMAT = lua ]]; then
    cp "$TMP/words.lua" "$OUTPUT"
elif [[ $FORMAT = pretty ]]; then
    _lua 'string.format("%d (+%d=%d)", w.text, w.other, w.text+w.other)'
elif [[ $FORMAT = strict ]]; then
    _lua 'w.text'
elif [[ $FORMAT = sum ]]; then
    _lua 'w.text+w.other'
else
    echo 1>&2 "unknown format: $FORMAT"
    exit 1
fi
